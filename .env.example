# ProfLM environment
# Leave ICA_API_KEY empty to run in DEMO MODE (scripted tutor, no live AI).
# Get a key in the ICA UI: Settings > API Keys > ICA APIs. Never commit a real key.
ICA_API_KEY=
# Model id from `npm run ica-check` (it lists the models your key can use)
ICA_MODEL=
# Optional: document collection with the teacher's files (see scripts/ica-upload.ts)
ICA_COLLECTION_ID=
